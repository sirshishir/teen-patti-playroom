# ── Broker selection ───────────────────────────────────────────────────────────
# Set to "alpaca" (default) or "webull"
BROKER=alpaca

# ── Alpaca credentials (required when BROKER=alpaca) ──────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Webull credentials (required when BROKER=webull) ──────────────────────────
# Obtain App Key and App Secret from https://developer.webull.com
WEBULL_APP_KEY=your_webull_app_key
WEBULL_APP_SECRET=your_webull_app_secret
# Your Webull account number (visible in the Webull desktop app under Account)
WEBULL_ACCOUNT_ID=your_webull_account_id

# ── Discord ────────────────────────────────────────────────────────────────────
# Option A — Gateway bot (recommended; enables the "Show Analysis" command):
#   DISCORD_BOT_TOKEN    = bot token from the Discord Developer Portal
#   DISCORD_CHANNEL_NAME = channel to post in, without '#' (default: price-alert)
#   DISCORD_CHANNEL_ID   = optional explicit channel ID (overrides name lookup;
#                          enable Settings → Advanced → Developer Mode, then
#                          right-click the channel → Copy Channel ID)
#
#   The bot must be in the server with "Send Messages" permission in the
#   target channel. The /analysis slash command works out of the box (no
#   privileged intents).
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_NAME=price-alert
# DISCORD_CHANNEL_ID=
#
#   Optional: to also allow the plain-text "show analysis" trigger, set the
#   flag below to true AND enable the MESSAGE CONTENT INTENT under Bot settings
#   in the Developer Portal. If the flag is true but the portal intent is not
#   enabled, Discord will refuse the connection and the bot won't come online.
# DISCORD_ENABLE_TEXT_COMMAND=false

# Option B — Webhook (fallback, no bot; no interactive commands). Used only if
# the gateway bot above is not running:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# ── Trading mode ───────────────────────────────────────────────────────────────
# NEVER change this to "live" without reviewing paper trading results first.
# The bot will NEVER switch to live automatically.
TRADING_MODE=paper
